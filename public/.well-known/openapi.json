{
  "openapi": "3.0.0",
  "info": {
    "version": "1.0.0",
    "title": "What The Commit",
    "description": "A simple API to get random commit messages"
  },
  "servers": [
    {
      "url": "https://whatthecommit.com"
    }
  ],
  "paths": {
    "/index.json": {
      "get": {
        "description": "Returns a random commit message.",
        "parameters": [
          {
            "in": "query",
            "name": "category",
            "description": "Message collection to sample (`legacy`, `database`, or `ai`). Defaults to `legacy`.",
            "schema": {
              "type": "string",
              "enum": ["legacy", "database", "ai"],
              "default": "legacy"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "category": {
                      "type": "string",
                      "example": "ai"
                    },
                    "hash": {
                      "type": "string",
                      "example": "0666a11c52b7786e994c483ad86bbe92"
                    },
                    "commit_message": {
                      "type": "string",
                      "example": "TODO: write meaningful commit message"
                    },
                    "permalink": {
                      "type": "string",
                      "example": "https://whatthecommit.com/0666a11c52b7786e994c483ad86bbe92"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
